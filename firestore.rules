rules_version = '2';

// Notties Firestore security rules (v0.13)
// Paste this into Firebase Console > Firestore Database > Rules, then Publish.
// Replace YOUR_ADMIN_EMAIL with the email you sign in to the admin panel with.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'YOUR_ADMIN_EMAIL';
    }

    // Registrations. Each person's record is stored under a key made from
    // their ID number, so a second registration with the same ID replaces
    // the first. The public may only write the record whose key matches the
    // ID number inside it, and can never read registrations.
    match /entries/{entryId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        || (request.resource.data.idNumber is string
            && request.resource.data.idNumber.matches('^[0-9]{13}$')
            && entryId == hashing.sha256(request.resource.data.idNumber).toHexString().lower());
    }

    // Public summary (counts only, no personal details).
    // Anyone can read it; only the admin panel rebuilds it.
    match /stats/summary {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
